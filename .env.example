# Copy to .env (or set these in Railway). Names match the old Flask app where possible.

# Postgres (the same database the Flask app used)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Public URL of this app, no trailing slash (FRONTEND_URL also works)
APP_URL=http://localhost:3000

# Signs the session cookie. Use a long random string.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# VideoSDK
VIDEOSDK_API_KEY=
VIDEOSDK_SECRET_KEY=
VIDEOSDK_API_ENDPOINT=https://api.videosdk.live/v2

# Stripe ($3/month Premium)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OAuth (optional; buttons only appear when both values are set)
# Redirect URIs to register:
#   Google: <APP_URL>/api/auth/google/callback
#   GitHub: <APP_URL>/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gmail sender for verification and reset emails (app password).
# Leave empty in local dev to print emails to the server log instead.
GMAIL=
GMAIL_PASSWORD=

# Local dev only: accepted as a verification code. Ignored when NODE_ENV=production.
VERIFICATION_BYPASS_CODE=
